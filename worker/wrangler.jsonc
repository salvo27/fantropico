{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fantropico-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Solo i log strutturati scritti dal codice: niente log automatici delle richieste (minimo dei dati)
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  // Pulizia giornaliera dei contatori vecchi (ore 03:00 UTC)
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "vars": {
    // Indirizzo del sito su Cloudflare Pages: l'unico origin accettato
    "ALLOWED_ORIGIN": "https://fantropico.pages.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fantropico",
      "database_id": "0a15985b-7b4e-4470-8804-826a6b5cd8d5",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "ABUSE_KV",
      "id": "50ed80839c1b4b94a3328c74df1a1b31"
    }
  ]
}
