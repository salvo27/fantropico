{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fantropico-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Solo i log strutturati scritti dal codice: niente log automatici delle richieste (minimo dei dati)
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  // Pulizia giornaliera dei contatori vecchi (ore 03:00 UTC)
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "vars": {
    // Dominio del sito su Cloudflare Pages: l'unico origin accettato
    "ALLOWED_ORIGIN": "https://fantropico.pages.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fantropico",
      // Sostituisci con l'id stampato da `wrangler d1 create fantropico`
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "ABUSE_KV",
      // Sostituisci con l'id stampato da `wrangler kv namespace create ABUSE_KV`
      "id": "00000000000000000000000000000000"
    }
  ]
}
